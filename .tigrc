set refresh-mode = periodic
set refresh-interval = 3
set ignore-space = at-eol
set ignore-case = true
set diff-highlight = true
color status white default

######
#key
######
bind main V !@git revert %(commit)
bind main ! !@git reset --hard %(commit)
bind main d !@git rebase --autostash --keep-empty --empty=keep --no-autosquash --onto %(commit)^ %(commit)
bind main R !git rebase -i %(commit)
bind main m :enter

bind diff R !@git rebase -i %(commit)
bind diff n :next
bind diff p :previous

bind status m :enter
bind status P !git push
bind status <Ctrl-a> !@git add -A
bind status C !@git commit -m %(prompt)
bind status A !@git commit --amend --no-edit
bind status <Ctrl-!> !@?rm %(file)
bind status R !@?git restore --source=%(commit) -- %(file)

bind stage n :next
bind stage p :previous

bind refs D !@?git branch -D %(branch)

bind stash s !@git stash save %(prompt)

bind generic Y @sh -c "echo '%(commit)' | pbcopy"
bind stage   Y @sh -c "echo '%(file)' | pbcopy"
bind status  Y @sh -c "echo '%(file)' | pbcopy"
bind tree    Y @sh -c "echo '%(file)' | pbcopy"
bind blob    Y @sh -c "echo '%(file)' | pbcopy"
bind generic <Ctrl-g> refresh

# move
bind main G none
bind generic g move-first-line
bind generic G move-last-line
bind generic J move-page-down
bind generic K move-page-up
bind generic ; view-main

bind main    ;      @gh browse %(commit)
bind blame   ;      @gh browse --blame --commit="%(ref)" "%(file):%(lineno)"
bind diff    ;      @gh browse --commit="%(head)" "%(file):%(lineno)"
bind tree    ;      @gh browse --commit="%(head)" "%(file)"
bind blob    ;      @gh browse --commit="%(head)" "%(file):%(lineno)"
bind grep    ;      @gh browse --commit="%(head)" "%(file)"
bind tree    <Esc>; @gh browse --branch "%(prompt Enter branch name: )" "%(file)"
bind blob    <Esc>; @gh browse --branch "%(prompt Enter branch name: )" "%(file)"
bind grep    <Esc>; @gh browse --branch "%(prompt Enter branch name: )" "%(file)"
bind main    w      @sh -c 'open "$(gh repo view --json url --jq .url)/compare/$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name)...%(branch)?expand=1"'
bind diff    w      @sh -c 'open "$(gh repo view --json url --jq .url)/compare/$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name)...%(branch)?expand=1"'
bind refs    w      @sh -c 'open "$(gh repo view --json url --jq .url)/compare/$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name)...%(branch)?expand=1"'

######
#display
######
set main-view = id date author commit-title:graph=yes,refs=yes
set mouse = yes
